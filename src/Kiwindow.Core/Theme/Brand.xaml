<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <!--
        Kiwindow brand mark. Single source of truth for the logo: the app renders it as vector and
        scripts/render-brand.ps1 rasterizes the same drawings into the .ico, the PNGs and the installer art.

        Concept: a kiwi slice cut into the Windows snap layout: one tall pane on the left, two stacked on the
        right. The top-right pane sits lifted out of place: a window about to snap back where it belongs.
        Grid: 256 x 256, slice centre (128,128), skin r100, flesh r90, core 24 x 30, seed ring r50,
        pane gap 14 px, lifted pane offset (+12,-12). Same dark squircle badge as the rest of the family.
    -->

    <!-- ═══ Palette ═══ -->
    <LinearGradientBrush x:Key="Brand.SkinBrush" StartPoint="0.2,0" EndPoint="0.8,1" po:Freeze="True">
        <GradientStop Color="#9A7146" Offset="0" />
        <GradientStop Color="#5E4024" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="Brand.FleshBrush" Center="128,128" GradientOrigin="118,116" RadiusX="90" RadiusY="90"
                         MappingMode="Absolute" po:Freeze="True">
        <GradientStop Color="#E3F3A0" Offset="0" />
        <GradientStop Color="#A9D654" Offset="0.42" />
        <GradientStop Color="#76B436" Offset="0.86" />
        <GradientStop Color="#5E9A2A" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Brand.CoreBrush" Center="0.5,0.5" GradientOrigin="0.42,0.38" RadiusX="0.6" RadiusY="0.6" po:Freeze="True">
        <GradientStop Color="#FBFAE6" Offset="0" />
        <GradientStop Color="#EAEDC2" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="Brand.SeedBrush" Color="#1E1A14" po:Freeze="True" />
    <SolidColorBrush x:Key="Brand.RayBrush" Color="#33F6FBDD" po:Freeze="True" />
    <LinearGradientBrush x:Key="Brand.BadgeBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#2B2825" Offset="0" />
        <GradientStop Color="#161514" Offset="1" />
    </LinearGradientBrush>

    <!-- ═══ Slice ═══ -->
    <!-- Seeds: 14 small drops on a ring, each pointing at the core. -->
    <GeometryGroup x:Key="Brand.Seeds" po:Freeze="True">
        <EllipseGeometry Center="128,78" RadiusX="4.2" RadiusY="8"><EllipseGeometry.Transform><RotateTransform Angle="0" CenterX="128" CenterY="128" /></EllipseGeometry.Transform></EllipseGeometry>
        <EllipseGeometry Center="128,78" RadiusX="4.2" RadiusY="8"><EllipseGeometry.Transform><RotateTransform Angle="25.7" CenterX="128" CenterY="128" /></EllipseGeometry.Transform></EllipseGeometry>
        <EllipseGeometry Center="128,78" RadiusX="4.2" RadiusY="8"><EllipseGeometry.Transform><RotateTransform Angle="51.4" CenterX="128" CenterY="128" /></EllipseGeometry.Transform></EllipseGeometry>
        <EllipseGeometry Center="128,78" RadiusX="4.2" RadiusY="8"><EllipseGeometry.Transform><RotateTransform Angle="77.1" CenterX="128" CenterY="128" /></EllipseGeometry.Transform></EllipseGeometry>
        <EllipseGeometry Center="128,78" RadiusX="4.2" RadiusY="8"><EllipseGeometry.Transform><RotateTransform Angle="102.9" CenterX="128" CenterY="128" /></EllipseGeometry.Transform></EllipseGeometry>
        <EllipseGeometry Center="128,78" RadiusX="4.2" RadiusY="8"><EllipseGeometry.Transform><RotateTransform Angle="128.6" CenterX="128" CenterY="128" /></EllipseGeometry.Transform></EllipseGeometry>
        <EllipseGeometry Center="128,78" RadiusX="4.2" RadiusY="8"><EllipseGeometry.Transform><RotateTransform Angle="154.3" CenterX="128" CenterY="128" /></EllipseGeometry.Transform></EllipseGeometry>
        <EllipseGeometry Center="128,78" RadiusX="4.2" RadiusY="8"><EllipseGeometry.Transform><RotateTransform Angle="180" CenterX="128" CenterY="128" /></EllipseGeometry.Transform></EllipseGeometry>
        <EllipseGeometry Center="128,78" RadiusX="4.2" RadiusY="8"><EllipseGeometry.Transform><RotateTransform Angle="205.7" CenterX="128" CenterY="128" /></EllipseGeometry.Transform></EllipseGeometry>
        <EllipseGeometry Center="128,78" RadiusX="4.2" RadiusY="8"><EllipseGeometry.Transform><RotateTransform Angle="231.4" CenterX="128" CenterY="128" /></EllipseGeometry.Transform></EllipseGeometry>
        <EllipseGeometry Center="128,78" RadiusX="4.2" RadiusY="8"><EllipseGeometry.Transform><RotateTransform Angle="257.1" CenterX="128" CenterY="128" /></EllipseGeometry.Transform></EllipseGeometry>
        <EllipseGeometry Center="128,78" RadiusX="4.2" RadiusY="8"><EllipseGeometry.Transform><RotateTransform Angle="282.9" CenterX="128" CenterY="128" /></EllipseGeometry.Transform></EllipseGeometry>
        <EllipseGeometry Center="128,78" RadiusX="4.2" RadiusY="8"><EllipseGeometry.Transform><RotateTransform Angle="308.6" CenterX="128" CenterY="128" /></EllipseGeometry.Transform></EllipseGeometry>
        <EllipseGeometry Center="128,78" RadiusX="4.2" RadiusY="8"><EllipseGeometry.Transform><RotateTransform Angle="334.3" CenterX="128" CenterY="128" /></EllipseGeometry.Transform></EllipseGeometry>
    </GeometryGroup>

    <!-- Faint rays from the core to the rim, the fibres of the flesh. -->
    <GeometryGroup x:Key="Brand.Rays" po:Freeze="True">
        <RectangleGeometry Rect="127,34,2,28"><RectangleGeometry.Transform><RotateTransform Angle="12.85" CenterX="128" CenterY="128" /></RectangleGeometry.Transform></RectangleGeometry>
        <RectangleGeometry Rect="127,34,2,28"><RectangleGeometry.Transform><RotateTransform Angle="38.55" CenterX="128" CenterY="128" /></RectangleGeometry.Transform></RectangleGeometry>
        <RectangleGeometry Rect="127,34,2,28"><RectangleGeometry.Transform><RotateTransform Angle="64.25" CenterX="128" CenterY="128" /></RectangleGeometry.Transform></RectangleGeometry>
        <RectangleGeometry Rect="127,34,2,28"><RectangleGeometry.Transform><RotateTransform Angle="89.95" CenterX="128" CenterY="128" /></RectangleGeometry.Transform></RectangleGeometry>
        <RectangleGeometry Rect="127,34,2,28"><RectangleGeometry.Transform><RotateTransform Angle="115.65" CenterX="128" CenterY="128" /></RectangleGeometry.Transform></RectangleGeometry>
        <RectangleGeometry Rect="127,34,2,28"><RectangleGeometry.Transform><RotateTransform Angle="141.35" CenterX="128" CenterY="128" /></RectangleGeometry.Transform></RectangleGeometry>
        <RectangleGeometry Rect="127,34,2,28"><RectangleGeometry.Transform><RotateTransform Angle="167.05" CenterX="128" CenterY="128" /></RectangleGeometry.Transform></RectangleGeometry>
        <RectangleGeometry Rect="127,34,2,28"><RectangleGeometry.Transform><RotateTransform Angle="192.75" CenterX="128" CenterY="128" /></RectangleGeometry.Transform></RectangleGeometry>
        <RectangleGeometry Rect="127,34,2,28"><RectangleGeometry.Transform><RotateTransform Angle="218.45" CenterX="128" CenterY="128" /></RectangleGeometry.Transform></RectangleGeometry>
        <RectangleGeometry Rect="127,34,2,28"><RectangleGeometry.Transform><RotateTransform Angle="244.15" CenterX="128" CenterY="128" /></RectangleGeometry.Transform></RectangleGeometry>
        <RectangleGeometry Rect="127,34,2,28"><RectangleGeometry.Transform><RotateTransform Angle="269.85" CenterX="128" CenterY="128" /></RectangleGeometry.Transform></RectangleGeometry>
        <RectangleGeometry Rect="127,34,2,28"><RectangleGeometry.Transform><RotateTransform Angle="295.55" CenterX="128" CenterY="128" /></RectangleGeometry.Transform></RectangleGeometry>
        <RectangleGeometry Rect="127,34,2,28"><RectangleGeometry.Transform><RotateTransform Angle="321.25" CenterX="128" CenterY="128" /></RectangleGeometry.Transform></RectangleGeometry>
        <RectangleGeometry Rect="127,34,2,28"><RectangleGeometry.Transform><RotateTransform Angle="346.95" CenterX="128" CenterY="128" /></RectangleGeometry.Transform></RectangleGeometry>
    </GeometryGroup>

    <!-- The whole slice, before it is cut into panes. -->
    <DrawingCollection x:Key="Brand.Slice" po:Freeze="True">
        <GeometryDrawing Brush="{StaticResource Brand.SkinBrush}">
            <GeometryDrawing.Geometry><EllipseGeometry Center="128,128" RadiusX="100" RadiusY="100" /></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="{StaticResource Brand.FleshBrush}">
            <GeometryDrawing.Geometry><EllipseGeometry Center="128,128" RadiusX="90" RadiusY="90" /></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="{StaticResource Brand.RayBrush}" Geometry="{StaticResource Brand.Rays}" />
        <GeometryDrawing Brush="{StaticResource Brand.CoreBrush}">
            <GeometryDrawing.Geometry><EllipseGeometry Center="128,128" RadiusX="24" RadiusY="30" /></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="{StaticResource Brand.SeedBrush}" Geometry="{StaticResource Brand.Seeds}" />
    </DrawingCollection>

    <!-- Small sizes: no rays, eight bold seeds. -->
    <DrawingCollection x:Key="Brand.SliceSmall" po:Freeze="True">
        <GeometryDrawing Brush="{StaticResource Brand.SkinBrush}">
            <GeometryDrawing.Geometry><EllipseGeometry Center="128,128" RadiusX="100" RadiusY="100" /></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="{StaticResource Brand.FleshBrush}">
            <GeometryDrawing.Geometry><EllipseGeometry Center="128,128" RadiusX="88" RadiusY="88" /></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="{StaticResource Brand.CoreBrush}">
            <GeometryDrawing.Geometry><EllipseGeometry Center="128,128" RadiusX="28" RadiusY="34" /></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="{StaticResource Brand.SeedBrush}">
            <GeometryDrawing.Geometry>
                <GeometryGroup>
                    <EllipseGeometry Center="128,76" RadiusX="7" RadiusY="12"><EllipseGeometry.Transform><RotateTransform Angle="22.5" CenterX="128" CenterY="128" /></EllipseGeometry.Transform></EllipseGeometry>
                    <EllipseGeometry Center="128,76" RadiusX="7" RadiusY="12"><EllipseGeometry.Transform><RotateTransform Angle="67.5" CenterX="128" CenterY="128" /></EllipseGeometry.Transform></EllipseGeometry>
                    <EllipseGeometry Center="128,76" RadiusX="7" RadiusY="12"><EllipseGeometry.Transform><RotateTransform Angle="112.5" CenterX="128" CenterY="128" /></EllipseGeometry.Transform></EllipseGeometry>
                    <EllipseGeometry Center="128,76" RadiusX="7" RadiusY="12"><EllipseGeometry.Transform><RotateTransform Angle="157.5" CenterX="128" CenterY="128" /></EllipseGeometry.Transform></EllipseGeometry>
                    <EllipseGeometry Center="128,76" RadiusX="7" RadiusY="12"><EllipseGeometry.Transform><RotateTransform Angle="202.5" CenterX="128" CenterY="128" /></EllipseGeometry.Transform></EllipseGeometry>
                    <EllipseGeometry Center="128,76" RadiusX="7" RadiusY="12"><EllipseGeometry.Transform><RotateTransform Angle="247.5" CenterX="128" CenterY="128" /></EllipseGeometry.Transform></EllipseGeometry>
                    <EllipseGeometry Center="128,76" RadiusX="7" RadiusY="12"><EllipseGeometry.Transform><RotateTransform Angle="292.5" CenterX="128" CenterY="128" /></EllipseGeometry.Transform></EllipseGeometry>
                    <EllipseGeometry Center="128,76" RadiusX="7" RadiusY="12"><EllipseGeometry.Transform><RotateTransform Angle="337.5" CenterX="128" CenterY="128" /></EllipseGeometry.Transform></EllipseGeometry>
                </GeometryGroup>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingCollection>

    <!-- ═══ Panes: the slice clipped into three, inner corners rounded like window corners ═══ -->
    <RectangleGeometry x:Key="Brand.PaneL" Rect="-40,-40,161,336" RadiusX="12" RadiusY="12" po:Freeze="True" />
    <RectangleGeometry x:Key="Brand.PaneTR" Rect="135,-40,161,161" RadiusX="12" RadiusY="12" po:Freeze="True" />
    <RectangleGeometry x:Key="Brand.PaneBR" Rect="135,135,161,161" RadiusX="12" RadiusY="12" po:Freeze="True" />
    <TranslateTransform x:Key="Brand.LiftOffset" X="12" Y="-12" po:Freeze="True" />

    <!-- Mark on a transparent background, for dark surfaces. -->
    <DrawingGroup x:Key="Brand.MarkDrawing" po:Freeze="True">
        <GeometryDrawing Brush="Transparent" Geometry="M0,0 H256 V256 H0 Z" />
        <DrawingGroup ClipGeometry="{StaticResource Brand.PaneL}" Children="{StaticResource Brand.Slice}" />
        <DrawingGroup ClipGeometry="{StaticResource Brand.PaneBR}" Children="{StaticResource Brand.Slice}" />
        <DrawingGroup Transform="{StaticResource Brand.LiftOffset}">
            <DrawingGroup ClipGeometry="{StaticResource Brand.PaneTR}" Children="{StaticResource Brand.Slice}" />
        </DrawingGroup>
    </DrawingGroup>

    <!-- App icon (40 px and up): mark on the family's dark squircle badge. -->
    <DrawingGroup x:Key="Brand.LogoDrawing" po:Freeze="True">
        <GeometryDrawing Brush="{StaticResource Brand.BadgeBrush}">
            <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,256,256" RadiusX="62" RadiusY="62" /></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <DrawingGroup>
            <DrawingGroup.Transform>
                <ScaleTransform CenterX="128" CenterY="132" ScaleX="0.8" ScaleY="0.8" />
            </DrawingGroup.Transform>
            <DrawingGroup ClipGeometry="{StaticResource Brand.PaneL}" Children="{StaticResource Brand.Slice}" />
            <DrawingGroup ClipGeometry="{StaticResource Brand.PaneBR}" Children="{StaticResource Brand.Slice}" />
            <DrawingGroup Transform="{StaticResource Brand.LiftOffset}">
                <DrawingGroup ClipGeometry="{StaticResource Brand.PaneTR}" Children="{StaticResource Brand.Slice}" />
            </DrawingGroup>
        </DrawingGroup>
    </DrawingGroup>

    <!-- Small icon (16-32 px): bolder slice, wider frame, a smaller lift so the panes stay readable. -->
    <RectangleGeometry x:Key="Brand.SmallL" Rect="-40,-40,159,336" RadiusX="14" RadiusY="14" po:Freeze="True" />
    <RectangleGeometry x:Key="Brand.SmallTR" Rect="137,-40,159,159" RadiusX="14" RadiusY="14" po:Freeze="True" />
    <RectangleGeometry x:Key="Brand.SmallBR" Rect="137,137,159,159" RadiusX="14" RadiusY="14" po:Freeze="True" />
    <DrawingGroup x:Key="Brand.LogoSmallDrawing" po:Freeze="True">
        <GeometryDrawing Brush="{StaticResource Brand.BadgeBrush}">
            <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,256,256" RadiusX="62" RadiusY="62" /></GeometryDrawing.Geometry>
        </GeometryDrawing>
        <DrawingGroup>
            <DrawingGroup.Transform>
                <ScaleTransform CenterX="128" CenterY="130" ScaleX="0.94" ScaleY="0.94" />
            </DrawingGroup.Transform>
            <DrawingGroup ClipGeometry="{StaticResource Brand.SmallL}" Children="{StaticResource Brand.SliceSmall}" />
            <DrawingGroup ClipGeometry="{StaticResource Brand.SmallBR}" Children="{StaticResource Brand.SliceSmall}" />
            <DrawingGroup>
                <DrawingGroup.Transform><TranslateTransform X="8" Y="-8" /></DrawingGroup.Transform>
                <DrawingGroup ClipGeometry="{StaticResource Brand.SmallTR}" Children="{StaticResource Brand.SliceSmall}" />
            </DrawingGroup>
        </DrawingGroup>
    </DrawingGroup>

    <DrawingImage x:Key="Brand.Mark" Drawing="{StaticResource Brand.MarkDrawing}" po:Freeze="True" />
    <DrawingImage x:Key="Brand.Logo" Drawing="{StaticResource Brand.LogoDrawing}" po:Freeze="True" />
</ResourceDictionary>
