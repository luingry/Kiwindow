<Application x:Class="Kiwindow.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Same design system as SwissTechKnife, so the app and the module look identical. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SwissTechKnife.Sdk;component/Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
